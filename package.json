{
  "name": "hunu",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "test": "npx esbuild scripts/test-engine.ts --bundle --platform=node --log-level=warning | node && npx esbuild scripts/test-search.ts --bundle --platform=node --log-level=warning | node",
    "test:e2e": "npx esbuild scripts/e2e-shared-prices.ts --bundle --platform=node --log-level=warning --define:__HUNU_API_URL__=process.env.HUNU_API_URL --outfile=node_modules/.cache/hunu-e2e.cjs && node --env-file=.env.local node_modules/.cache/hunu-e2e.cjs",
    "test:live": "npx esbuild scripts/smoke-live.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/hunu-smoke.cjs && node node_modules/.cache/hunu-smoke.cjs"
  },
  "dependencies": {
    "@fontsource/hind": "^5.3.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/realtime": "^0.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/leaflet": "1.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
