{
  "manifest_version": 3,
  "name": "Hunu: best deal finder",
  "version": "1.0.0",
  "description": "Search a product and see the deals ranked by landed cost, distance, fit and quality, then compare the top ones.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "contextMenus",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://ipwho.is/*",
    "https://freeipapi.com/*",
    "https://*/*",
    "*://*.google.com/*",
    "*://*.google.co.uk/*",
    "*://*.bing.com/*",
    "*://*.g2.com/*",
    "*://*.capterra.com/*",
    "*://*.clutch.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hunu",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.bing.com/*",
        "*://*.g2.com/*",
        "*://*.capterra.com/*",
        "*://*.clutch.co/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.bing.com/*",
        "*://*.g2.com/*",
        "*://*.capterra.com/*",
        "*://*.clutch.co/*"
      ]
    }
  ]
}
