{
  "name": "hunu-server",
  "private": true,
  "type": "module",
  "description": "Shared price reports API for Hunu",
  "scripts": {
    "cleanup:e2e": "node --env-file=../.env.local scripts/cleanup-e2e.mjs",
    "migrate": "node --env-file=../.env.local scripts/migrate.mjs",
    "dev": "npx esbuild src/node.ts --bundle --platform=node --format=esm --packages=external --outfile=.build/node.mjs --log-level=warning && node --env-file=../.env.local .build/node.mjs",
    "build:node": "npx esbuild src/node.ts --bundle --platform=node --format=esm --packages=external --outfile=.build/node.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "hono": "^4.13.19",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  }
}
